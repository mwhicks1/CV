#!/bin/bash
#
# Build the customized bibtex2html and bib2bib, and install them.
#
# Exports the upstream commit pinned by the bibtex2html/ submodule into
# build/, applies patches/bibtex2html-mwh.patch there, builds, and copies the
# two binaries to $BINDIR (default ~/bin). The submodule itself is never
# modified. Existing binaries are saved as <name>.prev before being replaced.
#
# usage: ./build-bibtex2html [--no-install]
#
# Needs: OCaml (ocamlopt), make, patch. Does NOT need autoconf: upstream does
# not commit its generated configure script, so a copy (generated by Autoconf
# 2.69 from the same configure.in) is kept in patches/bibtex2html-configure.

set -euo pipefail

root=$(cd "$(dirname "$0")" && pwd)
src="$root/bibtex2html"
build="$root/build/bibtex2html"
bindir="${BINDIR:-$HOME/bin}"
install=yes
[ "${1:-}" = "--no-install" ] && install=no

if [ ! -e "$src/.git" ]; then
  echo "Fetching bibtex2html submodule..."
  git -C "$root" submodule update --init bibtex2html
fi

echo "Exporting bibtex2html $(git -C "$src" rev-parse --short HEAD) to build/..."
rm -rf "$build"
mkdir -p "$build"
git -C "$src" archive HEAD | tar -x -C "$build"

echo "Applying patches/bibtex2html-mwh.patch..."
patch -d "$build" -p1 --quiet < "$root/patches/bibtex2html-mwh.patch"

if [ ! -e "$build/configure" ]; then
  cp "$root/patches/bibtex2html-configure" "$build/configure"
  chmod +x "$build/configure"
fi

cd "$build"
# Make sure make doesn't think configure is stale and try to run autoconf
touch configure
./configure > configure.log 2>&1 || { cat configure.log; exit 1; }
# "opt" builds just the native binaries (the default target also builds the
# manual, which needs hevea)
make opt > make.log 2>&1 || { tail -30 make.log; exit 1; }
echo "Built: $(./bibtex2html -version 2>&1 | head -1)"

if [ $install = yes ]; then
  mkdir -p "$bindir"
  for prog in bibtex2html bib2bib; do
    if [ -e "$bindir/$prog" ]; then
      cp -p "$bindir/$prog" "$bindir/$prog.prev"
    fi
    cp "$prog" "$bindir/$prog"
    echo "Installed $bindir/$prog"
  done
else
  echo "Not installed; binaries are in $build"
fi
