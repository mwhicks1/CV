# Build output from ./build-bibtex2html
/build/

# LaTeX outputs from checking mwh.bib with mwh.tex
/mwh.aux
/mwh.bbl
/mwh.blg
/mwh.dvi
/mwh.log
/mwh.pdf

# Generated by updatebib (html2md turns these into the website's content/papers/*.md)
/html/*.html
/html/bib2html*
/html/tmp/*
!/html/tmp/.gitkeep
/html/texput.log

# Old files no longer used by the pipeline (kept on disk, not tracked)
/html/alt/
/html/trash/
/html/files
/html/*.rb
/html/*.sav
/html/copyright.txt

# Editor and OS cruft
\#*\#
*~
.DS_Store
